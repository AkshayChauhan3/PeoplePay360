      "index": "bxvV",
      "roundness": null,
      "seed": 792314374,
      "version": 131,
      "versionNonce": 769727814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788513406514,
      "link": null,
      "locked": false,
      "text": "Computation Note:\n - Fixed Amount: uses the exact value entered in the rule, e.g. Meal Allowance = 2,000.\n - Percentage: calculates the rule as a percentage of a selected base such as Contract Wage,\nBasic Salary, or Gross Salary, e.g. HRA = 20% × Basic Salary.\n - Python Code / Formula: is used for advanced calculations where fixed or percentage methods\nare not sufficient, such as attendance-based salary, overtime, unpaid leave deductions, or\ncalculations using multiple salary-rule values.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "bwtIUHLL3_aKO4u5hd7xk",
      "originalText": "Computation Note:\n - Fixed Amount: uses the exact value entered in the rule, e.g. Meal Allowance = 2,000.\n - Percentage: calculates the rule as a percentage of a selected base such as Contract Wage, Basic Salary, or Gross Salary, e.g. HRA = 20% × Basic Salary.\n - Python Code / Formula: is used for advanced calculations where fixed or percentage methods are not sufficient, such as attendance-based salary, overtime, unpaid leave deductions, or calculations using multiple salary-rule values.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
