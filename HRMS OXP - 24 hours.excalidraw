      "link": null,
      "locked": false,
      "fontSize": 11.5,
      "fontFamily": 5,
      "text": "Expected participant understanding:\n• Time Off is a dropdown in the top navbar. Sub-items are Requests, Allocations and Time Off Types.\n• Requests are employee transactions.\n• Allocations grant balance to employees.\n• Time Off Types define policy rules such as approval flow, unit (days/hours), and whether allocation is required.\n• Approved requests should reduce balance only when the chosen type requires it.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expected participant understanding:\n• Time Off is a dropdown in the top navbar. Sub-items are Requests, Allocations and Time Off Types.\n• Requests are employee transactions.\n• Allocations grant balance to employees.\n• Time Off Types define policy rules such as approval flow, unit (days/hours), and whether allocation is required.\n• Approved requests should reduce balance only when the chosen type requires it.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
