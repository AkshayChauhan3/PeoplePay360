      "isDeleted": true,
      "boundElements": [],
      "updated": 1788412275432,
      "link": null,
      "locked": false,
      "index": "b5B",
      "width": 1904,
      "height": 42.5,
      "text": "Participants should understand that the Dashboard belongs inside the Payroll module, but its insights depend on multiple HR modules.\nThis creates a practical data challenge: define domains/filters, aggregate values correctly for the selected period, and present them in a way that is useful for payroll officers and HR managers.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Participants should understand that the Dashboard belongs inside the Payroll module, but its insights depend on multiple HR modules.\nThis creates a practical data challenge: define domains/filters, aggregate values correctly for the selected period, and present them in a way that is useful for payroll officers and HR managers.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
