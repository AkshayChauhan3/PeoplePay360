      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 5,
      "text": "• Clicking the red attendance icon should open a popup.\n• If there is no active session, show Check In.\n• If the user is already checked in, show Check Out.\n• The popup should display elapsed time till now.\n• After successful Check In, the status indicator changes to green.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Clicking the red attendance icon should open a popup.\n• If there is no active session, show Check In.\n• If the user is already checked in, show Check Out.\n• The popup should display elapsed time till now.\n• After successful Check In, the status indicator changes to green.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
