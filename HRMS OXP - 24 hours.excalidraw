      "version": 80,
      "versionNonce": 1578503349,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788412269777,
      "link": null,
      "locked": false,
      "fontSize": 11.5,
      "fontFamily": 5,
      "text": "Participants should make the following flow obvious without extra explanation:\n1. A Payrun has a period and Salary Structure.\n2. Computing the run produces employee payslips and surfaces warnings.\n3. A payslip shows worked days plus basic/gross/net salary and rule-level computation.\n4. A payslip can be generated as PDF.\n5. The Payrun can send payslips to the employees by email.\n6. Salary Structures and Rules are configurable through List and Form views.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Participants should make the following flow obvious without extra explanation:\n1. A Payrun has a period and Salary Structure.\n2. Computing the run produces employee payslips and surfaces warnings.\n3. A payslip shows worked days plus basic/gross/net salary and rule-level computation.\n4. A payslip can be generated as PDF.\n5. The Payrun can send payslips to the employees by email.\n6. Salary Structures and Rules are configurable through List and Form views.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
