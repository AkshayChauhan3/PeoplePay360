    {
      "id": "QD2F74LZmX1nFuKNXxOHV",
      "type": "text",
      "x": 1596.946887603685,
      "y": 8169.053407963815,
      "width": 937.3391723632812,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
