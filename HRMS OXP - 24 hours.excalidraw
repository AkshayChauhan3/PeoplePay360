      "link": null,
      "locked": false,
      "fontSize": 11.5,
      "fontFamily": 5,
      "text": "The source also shows configurable sending timing: on confirmation, when paid, or manual.\nFor the hackathon flow, the essential behavior is a clear Send Payslips action on the Payrun and a PDF output for each individual payslip.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The source also shows configurable sending timing: on confirmation, when paid, or manual.\nFor the hackathon flow, the essential behavior is a clear Send Payslips action on the Payrun and a PDF output for each individual payslip.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
