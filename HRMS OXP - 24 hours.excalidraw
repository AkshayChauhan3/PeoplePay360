      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Useful note: if the selected type requires allocation, the request should clearly show which balance was consumed.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "iyCY-CFYgVBfZdvMZVKdm",
      "type": "rectangle",
      "x": 1351.5357127982093,
