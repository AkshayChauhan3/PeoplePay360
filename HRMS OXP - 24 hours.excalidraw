    {
      "id": "6aaa0857524347c5bc17",
      "type": "text",
      "x": 2758,
      "y": 6354,
      "strokeColor": "#5c4d00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
