    {
      "id": "zNY862sCOKJpv3iUmeEN-",
      "type": "text",
      "x": 2170.865874472214,
      "y": -586.4673530052711,
      "width": 1325,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
