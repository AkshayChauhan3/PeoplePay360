      "link": null,
      "locked": false,
      "index": "b55",
      "width": 1904,
      "height": 63.75,
      "text": "This dashboard is intentionally cross-functional. Participants should not populate it from a single model.\nA good solution fetches and aggregates data from Payroll, Employee/Department, Contract, Attendance, and Time Off models.\nThe goal is to test how well they can combine business data into actionable HR/payroll insights.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This dashboard is intentionally cross-functional. Participants should not populate it from a single model.\nA good solution fetches and aggregates data from Payroll, Employee/Department, Contract, Attendance, and Time Off models.\nThe goal is to test how well they can combine business data into actionable HR/payroll insights.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
