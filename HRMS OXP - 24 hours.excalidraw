    {
      "id": "payroll_1502_123596",
      "type": "text",
      "x": 3718.312343720521,
      "y": 5091.201491248349,
      "width": 650,
      "height": 93,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a001503",
