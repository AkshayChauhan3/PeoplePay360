    {
      "id": "8c6e40bf6acc4bf48419",
      "type": "text",
      "x": 2758,
      "y": 6034,
      "strokeColor": "#5c4d00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
