      "isDeleted": true,
      "boundElements": [],
      "updated": 1788419252722,
      "link": null,
      "locked": false,
      "index": "b58V",
      "width": 1904,
      "height": 127.5,
      "text": "Minimum dashboard content:\n• Salary payment KPIs: total net salary, number of payslips, paid/pending state.\n• Department overview: headcount or total salary by department.\n• Time Off overview: approved leave days, pending requests, remaining balances by type.\n• Attendance overview: present/absent/late counts, overtime or data-quality gaps.\n• At least 2 visual summaries such as bar charts, line charts, stacked charts, or compact tables.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Minimum dashboard content:\n• Salary payment KPIs: total net salary, number of payslips, paid/pending state.\n• Department overview: headcount or total salary by department.\n• Time Off overview: approved leave days, pending requests, remaining balances by type.\n• Attendance overview: present/absent/late counts, overtime or data-quality gaps.\n• At least 2 visual summaries such as bar charts, line charts, stacked charts, or compact tables.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
