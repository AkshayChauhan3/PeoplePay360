      "link": null,
      "locked": false
    },
    {
      "id": "fW7bCk-MCWZgKikXC1P5p",
      "type": "text",
      "x": -726.8381275470333,
      "y": -875.4090135684219,
      "width": 1190.2708740234375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQd",
      "roundness": null,
      "seed": 1497409602,
      "version": 855,
      "versionNonce": 2082705316,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788419904336,
      "link": null,
      "locked": false,
      "text": "Time Off:\n\n- Requests should support a simple approval flow.\n- For leave types that require allocation, approved leave should reduce the\nemployee’s available balance.\n- If a Time Off Type is marked as **Requires Allocation**, an employee must have an\navailable allocation for that leave type before they can submit a Time Off Request.\n- Time Off Types should define how each leave type behaves. The exact policies and\nvalidations are open to interpretation.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "beuIVH5As4PJ0Etvm7lRH",
      "originalText": "Time Off:\n\n- Requests should support a simple approval flow.\n- For leave types that require allocation, approved leave should reduce the employee’s available balance.\n- If a Time Off Type is marked as **Requires Allocation**, an employee must have an available allocation for that leave type before they can submit a Time Off Request.\n- Time Off Types should define how each leave type behaves. The exact policies and validations are open to interpretation.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
