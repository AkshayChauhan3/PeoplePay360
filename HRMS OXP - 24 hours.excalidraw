    {
      "id": "e810_537727",
      "type": "text",
      "x": 3381.840892913072,
      "y": 2222.6452549756555,
      "width": 811,
      "height": 62,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a000811",
      "roundness": null,
      "seed": 5811,
      "version": 34,
      "versionNonce": 1073054683,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788412263536,
      "link": null,
      "locked": false,
      "fontSize": 11.5,
      "fontFamily": 5,
      "text": "• Navigation should feel obvious from the wireframe alone.\n• Related screens should clearly show parent-child relationships, especially Employee → Contract / Attendance / Time Off data.\n• Payroll-sensitive dependencies should not be hidden: Running contract and leave balance rules should be explicit.\n• Avoid extra noise in the UI; keep only information that helps HR users act on records quickly.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Navigation should feel obvious from the wireframe alone.\n• Related screens should clearly show parent-child relationships, especially Employee → Contract / Attendance / Time Off data.\n• Payroll-sensitive dependencies should not be hidden: Running contract and leave balance rules should be explicit.\n• Avoid extra noise in the UI; keep only information that helps HR users act on records quickly.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
