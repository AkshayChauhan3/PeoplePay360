# ============================================================
# PeoplePay360 — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/peoplepay360

# ----------------------------------------------------------
# JWT / Security
# ----------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-generate-a-real-secret-key

JWT_ALGORITHM=HS256

# Access token TTL in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token TTL in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Comma-separated list of allowed origins (no trailing slash)
# Example: http://localhost:3000,https://app.peoplepay360.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_ENV=development

